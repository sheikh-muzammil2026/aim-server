<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "https://aimpurbachal.com"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, x-user-email, x-user-role, Accept, Origin"
    Header set Access-Control-Allow-Credentials "true"
</IfModule>

# OPTIONS (Preflight) 
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]